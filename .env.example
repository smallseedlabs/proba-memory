# proba-memory configuration. Copy to .env for local runs; never commit real values.
# Every value below is a placeholder or a safe default. See docs/ARCHITECTURE.md for what each adapter does.

NODE_ENV=development            # development | test | production
LOG_LEVEL=info                  # structured JSON on stdout, every line carries traceId
HOST=0.0.0.0                    # bind address of the HTTP servers

# --- Adapters (registry names) ---------------------------------------------------------------
MEMORY_STORE=postgres
VECTOR_INDEX=postgres           # pgvector HNSW, cosine
SCORING_PROFILE_STORE=postgres
RETRIEVAL_LOG_STORE=postgres
JOB_RUN_STORE=postgres
OUTBOX_STORE=postgres
EVENT_BUS=redis-streams
EMBEDDER=openai-compatible      # openai-compatible | hash (local only)
LLM_PROVIDER=deepseek           # deepseek | openai-compatible | scripted (local only)
TOKEN_COUNTER=approx
JOB_SCHEDULER=interval          # interval | manual
OUTCOME_LINKER=noop

# --- Postgres + pgvector ---------------------------------------------------------------------
DATABASE_URL=postgresql://proba:CHANGE_ME@localhost:25432/proba_memory
PG_POOL_MAX=10
# Vector length of memories.embedding. Must match the embedding model; changing it later needs a re-embed migration.
EMBEDDING_DIMENSION=1024

# --- Redis Streams (audit stream in, audit events out) ---------------------------------------
REDIS_URL=redis://localhost:26379
AUDIT_TOPIC=proba.audit.events
MEMORY_AUDIT_CONSUMER_GROUP=memory-ingestor
AUDIT_TRANSPORT=outbox          # outbox (transactional, relayed) | bus (direct)
AUDIT_WORKSPACE_ID=seedbed

# --- Embedder (any OpenAI-compatible /embeddings endpoint) -----------------------------------
EMBEDDER_BASE_URL=
EMBEDDER_MODEL=
EMBEDDER_VERSION=1
EMBEDDER_API_KEY=
ALLOW_LOCAL_EMBEDDER=false      # the local hash embedder refuses production unless true

# --- LLM (OpenAI-compatible chat completions; DeepSeek preset) -------------------------------
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash        # confirm the model name with your provider
LLM_API_KEY=
LLM_EXTRA_BODY=                 # optional JSON merged into every request body
ALLOW_SCRIPTED_LLM=false        # the scripted provider refuses production unless true

# --- Write path ------------------------------------------------------------------------------
SOURCES=audit                   # audit | content | audit,content
HUB_CONTENT_SOURCE=dev          # secondary source; a Hub feed adapter is an open question
ALLOW_DEV_CONTENT_SOURCE=false
REDACT_PII=true                 # secrets are always redacted; this adds email and phone numbers
RESOLVER_SIMILARITY_THRESHOLD=0.9
RESOLVER_RELATED_THRESHOLD=0.75
INGEST_CONCURRENCY=4

# --- Retrieval -------------------------------------------------------------------------------
RETRIEVAL_DEFAULT_LIMIT=10
RETRIEVAL_MAX_LIMIT=50
RETRIEVAL_PROFILE_NAME=default
RERANK_ENABLED=false

# --- Jobs ------------------------------------------------------------------------------------
JOBS_ENABLED=decay
DECAY_INTERVAL_MS=3600000
DECAY_CONFIDENCE_FLOOR=0.05
DECAY_IMPORTANCE_FLOOR=0.05
# DECAY_HALF_LIFE_DAYS=working=1,episodic=14,semantic=180,procedural=365,super=730

# --- Read API --------------------------------------------------------------------------------
MEMORY_API_TOKEN_VERIFIER=firebase   # firebase | static (never in production)
FIREBASE_PROJECT_ID=
MEMORY_API_WORKSPACE_ID=seedbed      # the workspace this deployment serves, injected into every call
MEMORY_API_ALLOWED_EMAILS=
MEMORY_API_ALLOWED_EMAIL_DOMAINS=
MEMORY_API_ADMIN_EMAILS=
MEMORY_API_CORS_ORIGINS=
MEMORY_API_RATE_LIMITER=memory       # memory | redis (redis when running several replicas)
# Local runs only: JSON array of { token, subject, email }.
# MEMORY_API_STATIC_TOKENS=[{"token":"CHANGE_ME_LOCAL_TOKEN","subject":"local-dev","email":"dev@proba.local"}]
